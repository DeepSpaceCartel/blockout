{
  "expo": {
    "name": "Blockout",
    "slug": "blockout",
    "scheme": "blockout",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deepspacecartel.blockout"
    },
    "android": {
      "package": "com.deepspacecartel.blockout",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "server": "https://blockout.deepspacecartel.com",
      "keycloakClientId": "blockout-mobile"
    }
  }
}
