# What only you have, as 1Password references (op://<vault>/<item>/<field>): no
# secrets here. Use: op run --env-file=deploy/blockout/.env.1password -- deploy/blockout/install.sh <version>
# The names and fields are examples: point them at your own items.
BLOCKOUT_GOOGLE_CLIENT_SECRET=op://Blockout/Google OAuth/client-secret
BLOCKOUT_GHCR_USER=op://Blockout/GHCR pull/username
BLOCKOUT_GHCR_TOKEN=op://Blockout/GHCR pull/token
# Mail (optional)
# BLOCKOUT_SMTP_HOST=op://Blockout/SMTP/host
# BLOCKOUT_SMTP_PORT=587
# BLOCKOUT_SMTP_FROM=op://Blockout/SMTP/from
# BLOCKOUT_SMTP_USER=op://Blockout/SMTP/username
# BLOCKOUT_SMTP_PASSWORD=op://Blockout/SMTP/password
# Backups (optional; any RCLONE_CONFIG_* turns them on)
# RCLONE_CONFIG_STORE_TYPE=s3
# RCLONE_CONFIG_STORE_PROVIDER=Other
# RCLONE_CONFIG_STORE_ENDPOINT=op://Blockout/Backup storage/endpoint
# RCLONE_CONFIG_STORE_ACCESS_KEY_ID=op://Blockout/Backup storage/access-key
# RCLONE_CONFIG_STORE_SECRET_ACCESS_KEY=op://Blockout/Backup storage/secret-key
# RCLONE_CONFIG_CRYPT_TYPE=crypt
# RCLONE_CONFIG_CRYPT_REMOTE=op://Blockout/Backup storage/crypt-remote
# RCLONE_CONFIG_CRYPT_PASSWORD=op://Blockout/Backup storage/crypt-password-obscured
