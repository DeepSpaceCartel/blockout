{
  "realm": "blockout",
  "displayName": "Blockout",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 28800,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "student",
        "description": "A child in a class"
      },
      {
        "name": "teacher",
        "description": "Hosts classes, sets homework"
      },
      {
        "name": "parent",
        "description": "Sees their linked children"
      }
    ]
  },
  "clients": [
    {
      "clientId": "blockout",
      "name": "Blockout",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "identity provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "identity_provider",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "displayName": "Google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "336840010192-o7fu9qa4d2iuaa9q7t6crbtuc3i9t0sa.apps.googleusercontent.com",
        "clientSecret": "${vault.google-secret}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "prompt": "select_account"
      }
    }
  ]
}
