{
  "name": "blockout",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Blockout: multiplication (and more) as area. A Turborepo of plain JavaScript apps and packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "start": "npm run build && node apps/server/src/index.js 8080"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "turbo": "^2.11.3",
    "vite": "^8.3.0"
  }
}
